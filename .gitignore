**/model_profile_keys.json
**/model_profile_keys*.json
**/*api_key*.json
**/*api-key*.json
**/*secret*.json
**/*token*.json

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
coverage.xml
htmlcov/

# Test suite data policy
# Public unit tests and small synthetic fixtures are tracked. Keep real novels,
# user cache exports, generated smoke output, and private repro assets local.
tests/private/
tests/fixtures/*
!tests/fixtures/public/
!tests/fixtures/public/**
tests/**/*.epub
tests/**/*.txt
!tests/fixtures/public/**
tests/**/smoke_out/

